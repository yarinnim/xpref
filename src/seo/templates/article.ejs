<% if (locals.publishedTime) { %>
<meta property="article:published_time" content="<%= publishedTime %>">
<% } %>
<% if (locals.modifiedTime) { %>
<meta property="article:modified_time" content="<%= modifiedTime %>">
<% } %>
<% if (locals.expirationTime) { %>
<meta property="article:expiration_time" content="<%= expirationTime %>">
<% } %>
<% (Array.isArray(locals.authors) ? authors : (locals.author ? [author] : [])).forEach(function (author) { %>
<meta property="article:author" content="<%= typeof author === 'object' ? author.url : author %>">
<% }) %>
<% if (locals.section) { %>
<meta property="article:section" content="<%= section %>">
<% } %>
<% (Array.isArray(locals.tags) ? tags : (locals.tag ? [tag] : [])).forEach(function (tag) { %>
<meta property="article:tag" content="<%= tag %>">
<% }) %>
